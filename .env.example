# Copy to .env and fill in. NEVER commit the real .env.
# These are configuration pointers only — NO secret VALUES belong here.

# AWS region used by boto3 clients and Terraform.
AWS_REGION=us-east-1

# Environment namespace prefix used in secret names (dev | prod).
SECRETS_ENV=dev

# Logical application name used in the naming convention <env>/<app>/<kind>.
APP_NAME=myapp

# Log level for the structured logger (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO

# Path to the YAML policy file used by the compliance checker.
POLICY_FILE=policies/rotation-policy.yaml

# --- AWS integration tests ---
# Set to 1 to enable tests that run against the deployed AWS environment.
RUN_AWS_INTEGRATION=0
# The deployed secret ids the integration tests target.
SECRET_ID=dev/myapp/database
API_SECRET_ID=dev/myapp/external-api
