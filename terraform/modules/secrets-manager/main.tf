# Secrets Manager module: creates the master, database, and API secrets with
# metadata and tags.
#
# Key security choices:
#   * No real secret value is written from Terraform configuration. The initial
#     database/master passwords are generated by the `random_password` resource
#     at apply time (never committed, never a plaintext var) and the secret
#     JSON is created once. Thereafter the *value* is managed by rotation, so we
#     ignore_changes on secret_string to avoid Terraform fighting rotation.
#   * random_password values DO land in Terraform state. State must therefore be
#     stored encrypted with restricted access (see environments/dev/backend).
#     This is called out in docs/terraform-state.md.
#   * Tags carry ownership/lifecycle metadata only — never credentials.
#   * The database secret is wired to the rotation Lambda with the configured
#     automatic schedule.

terraform {
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 6.0" }
    random = { source = "hashicorp/random", version = "~> 3.6" }
  }
}

locals {
  base = "${var.environment}/${var.app_name}"
}

# ---- Master secret (admin login used by rotation to ALTER app roles) ----
resource "aws_secretsmanager_secret" "master" {
  name                    = "${local.base}/database-master"
  recovery_window_in_days = 0
  description             = "Master login used by rotation to ALTER application roles."
  tags                    = merge(var.tags, { kind = "database-master" })
}

resource "aws_secretsmanager_secret_version" "master" {
  secret_id = aws_secretsmanager_secret.master.id
  secret_string = jsonencode({
    engine   = "postgres"
    host     = var.db_host
    port     = var.db_port
    dbname   = var.db_name
    username = var.db_master_username
    password = var.db_master_password
  })

  lifecycle {
    # The value is managed outside Terraform after creation.
    ignore_changes = [secret_string]
  }
}

# ---- Application database secret (alternating users) ----
resource "random_password" "app" {
  length           = 32
  special          = true
  override_special = "!#%*-_=+:?"
}

resource "aws_secretsmanager_secret" "database" {
  name                    = "${local.base}/database"
  recovery_window_in_days = 0
  description             = "Application database credential (alternating users)."
  tags                    = merge(var.tags, { kind = "database" })
}

resource "aws_secretsmanager_secret_version" "database" {
  secret_id = aws_secretsmanager_secret.database.id
  secret_string = jsonencode({
    engine    = "postgres"
    host      = var.db_host
    port      = var.db_port
    dbname    = var.db_name
    username  = "${var.app_name}_a"
    password  = random_password.app.result
    masterarn = aws_secretsmanager_secret.master.arn
  })

  lifecycle {
    ignore_changes = [secret_string]
  }
}

# NOTE: automatic rotation wiring (aws_secretsmanager_secret_rotation) is
# defined at the environment level, not here. The rotation resource must depend
# on BOTH this secret and the rotation Lambda; keeping it in this module would
# create a cycle (secret -> lambda -> secret-ARN-for-invoke-permission).

# ---- External API secret ----
resource "aws_secretsmanager_secret" "api" {
  name                    = "${local.base}/external-api"
  recovery_window_in_days = 0
  description             = "External API credential (rotated via custom workflow)."
  tags                    = merge(var.tags, { kind = "external-api" })
}

resource "aws_secretsmanager_secret_version" "api" {
  secret_id     = aws_secretsmanager_secret.api.id
  secret_string = jsonencode({ api_key = "PLACEHOLDER_SET_OUT_OF_BAND", provider = var.api_provider })

  lifecycle {
    ignore_changes = [secret_string]
  }
}
